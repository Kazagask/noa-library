{
  "name": "noa-library",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "NOA Library - 叙事层外置记忆与运行环境（零第三方运行时依赖）",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "verify": "node scripts/cli.ts verify",
    "coldstart": "node scripts/cli.ts coldstart",
    "recall": "node scripts/cli.ts recall",
    "traverse": "node scripts/cli.ts traverse",
    "checkpoint": "node scripts/cli.ts checkpoint",
    "restore": "node scripts/cli.ts restore",
    "export": "node scripts/cli.ts export",
    "import": "node scripts/cli.ts import",
    "serve": "node packages/server/index.ts",
    "mcp": "node packages/mcp/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:mcp": "node scripts/mcp-client.ts",
    "runtime": "node scripts/runtime-exec.ts",
    "index": "node scripts/cli.ts index",
    "persona": "node scripts/persona.ts",
    "import-history": "node scripts/import-history.ts",
    "vault": "node scripts/vault.ts",
    "asset": "node scripts/asset.ts",
    "migrate-archive": "node scripts/migrate-archive.ts",
    "backup": "node scripts/backup.ts",
    "dev:local": "node packages/local/http.ts",
    "db:init": "node packages/local/cli.ts db:init",
    "archive:import": "node packages/local/cli.ts archive:import",
    "archive:export": "node packages/local/cli.ts archive:export",
    "test:smoke": "node packages/local/cli.ts test:smoke",
    "test:gate": "node scripts/test-gate.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "recover:r1550": "node scripts/noa-infra-002.mjs all",
    "recover:r1550:prepare": "node scripts/noa-infra-003.mjs prepare",
    "recover:r1550:import": "node scripts/noa-infra-003.mjs import",
    "recover:r1550:status": "node scripts/noa-infra-003.mjs status",
    "recover:r1550:finalize": "node scripts/noa-infra-003.mjs finalize",
    "recover:r1550:abort": "node scripts/noa-infra-003.mjs abort"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "5.9"
  }
}
